# SnapFit – .gitignore

# OS generated files
.DS_Store

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Maven build output
/target/
*.jar
*.war
*.ear

# Gradle (if ever used)
.gradle
/build/

# Node / npm artifacts
node_modules/

# IDE specific files
.idea/
.vscode/
*.iml

# Temporary files
*.tmp
*.swp

# AI & Scaffold temporary files (Antigravity customizations)
.agents/
.claude/
.cursor/
.devin/

# Miscellaneous
coverage/
*.class
*.project
*.classpath
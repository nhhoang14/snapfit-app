# App Config
PROJECT_NAME="SnapFit API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="supersecret_change_me_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./snapfit.db"
# Or PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://snapfit:snapfit@localhost:5432/snapfit_db"

# Pinterest API Integration
PINTEREST_APP_ID="your_pinterest_app_id"
PINTEREST_APP_SECRET="your_pinterest_app_secret"
PINTEREST_ACCESS_TOKEN=""

# Media & Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# CORS Settings (comma separated)
BACKEND_CORS_ORIGINS="http://localhost:8081,http://localhost:19006,http://localhost:3000,*"
